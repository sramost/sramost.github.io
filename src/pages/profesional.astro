---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [
  { number: '01', title: 'Producción musical', description: 'Dar forma a proyectos musicales y acompañar su desarrollo.' },
  { number: '02', title: 'Transcripción', description: 'Trasladar material musical a partituras para su interpretación.' },
  { number: '03', title: 'Arreglos musicales', description: 'Adaptar repertorios a las necesidades de cada agrupación.' }
];
---
<BaseLayout title="Perfil profesional" description="Desarrollo backend Java, APIs REST y proyectos de Santiago Ramos" showHeader={false} wide={true}>
<section class="professional" lang="es">
  <header class="intro">
    <div><p class="eyebrow">Santiago Ramos / Perfil profesional</p><h1>Construcción de soluciones<br/><em>desde el backend.</em></h1></div>
    <div class="intro-copy"><p>Estudiante de Ingeniería de Sistemas con especial interés en Java y el desarrollo de aplicaciones web y APIs REST mediante Spring Boot. Me enfoco en conectar la lógica de negocio con los datos y construir soluciones que respondan a necesidades concretas.</p><a href="https://github.com/sramost" target="_blank" rel="noopener noreferrer">Mi GitHub ↗</a></div>
  </header>
  <div class="stack" aria-label="Tecnologías y áreas de interés"><span>Java</span><span>Spring Boot</span><span>API REST</span><span>PostgreSQL</span><span>MongoDB</span><span>Git</span></div>
  <div class="work-heading"><h2>Proyectos seleccionados</h2><span>Desarrollo web · Backend</span></div>
  <div class="work-grid">
    <article class="tap">
      <div class="tap-visual">
        <div class="tap-top"><span>PROYECTO DESTACADO</span><span>EN DESARROLLO</span></div>
        <svg viewBox="0 0 640 220" aria-hidden="true"><g stroke="#c8f2cb" stroke-width="1" opacity=".22"><path d="M0 50H640M0 80H640M0 110H640M0 140H640M0 170H640"/></g><g fill="none" stroke="#c8f2cb" stroke-width="3" stroke-linecap="round"><path d="M0 110H72L85 83L101 147L118 40L135 179L152 90L170 110H230L247 63L264 152L281 19L298 200L315 65L332 140L349 110H404L420 92L436 140L452 54L469 165L486 89L501 110H640"/></g></svg>
        <div class="tap-wordmark">TAP<span>ESTUDIO</span><small>Música / Tecnología</small></div>
      </div>
      <div class="tap-content"><p class="eyebrow">Proyecto actual · Plataforma web</p><h3>TAP ESTUDIO</h3><p>Una plataforma digital para conectar a bandas, agrupaciones musicales, colegios y otros proyectos artísticos con servicios especializados de producción, transcripción y arreglos musicales.</p><p>El propósito es reunir en un mismo espacio la presentación del estudio, un portafolio de trabajos realizados, una descripción detallada de los servicios y un canal de contacto para que los interesados puedan plantear sus necesidades.</p>
        <div class="services">{services.map(s=><div><span>{s.number}</span><h4>{s.title}</h4><p>{s.description}</p></div>)}</div>
        <div class="tap-bottom"><div><strong>Estado actual</strong><p>Definición del alcance y planificación de la solución. Código aún no disponible.</p></div><div><strong>Mi enfoque</strong><p>Diseño de la aplicación web y futura implementación de sus servicios e integración.</p></div></div>
      </div>
    </article>
    <aside class="side">
      <article class="small-project"><p class="eyebrow">Proyecto académico · Implementación</p><div class="chatly-visual"><span>Chatly<span class="dot">.</span></span><div class="bubble">Hola, ¿cómo vas?</div><div class="bubble reply">¡Todo listo!</div><small>Ilustración conceptual</small></div><h3>Chatly</h3><p>Sistema de mensajería con Angular, Spring Boot, PostgreSQL y MongoDB. Integración de dos motores, procedimientos almacenados y autenticación JWT.</p><a href="/evidencias/chatly/">Explorar el proyecto ↗</a></article>
      <article class="small-project"><p class="eyebrow">Práctica continua</p><h3>Otros desarrollos</h3><p>Proyectos de menor alcance y ejercicios de programación que fortalecen mis habilidades en Java, diseño de soluciones, consultas SQL e integración de datos.</p><a href="/evidencias/">Ver evidencias técnicas ↗</a></article>
    </aside>
  </div>
  <section class="skills contact-section" aria-labelledby="contact-title"><div><p class="eyebrow">Contacto</p><h2 id="contact-title">Hablemos</h2><p>Disponible para conversar sobre proyectos y oportunidades de colaboración.</p></div><div class="contact-option"><h3>Correo electrónico</h3><a href="mailto:sramost@unbosque.edu.co">sramost@unbosque.edu.co ↗</a></div><div class="contact-option"><h3>WhatsApp</h3><p>Próximamente disponible.</p></div></section>
  <footer class="professional-footer"><div><h2>Sigamos construyendo.</h2><p>Interesado en oportunidades de aprendizaje, colaboración y desarrollo de software.</p></div><a href="https://github.com/sramost" target="_blank" rel="noopener noreferrer">Conoce mi trabajo ↗</a></footer>
</section>
</BaseLayout>
<style>
.professional{max-width:1200px;margin:0 auto;padding:0 0 1rem}.eyebrow{font-size:.68rem;text-transform:uppercase;letter-spacing:.15em;font-weight:650;opacity:.73}.intro{display:grid;grid-template-columns:1.45fr 1fr;align-items:end;gap:3rem;margin-bottom:2rem}.intro h1{font-family:var(--font-serif);font-size:clamp(2.6rem,5.7vw,5.5rem);line-height:.98;letter-spacing:-.04em;margin-top:1.2rem}.intro h1 em{font-weight:400}.intro-copy{font-size:1rem;line-height:1.75;max-width:420px}.professional a{display:inline-block;font-size:.86rem;font-weight:600;text-decoration:underline;text-underline-offset:4px;margin-top:1rem}.stack{display:flex;flex-wrap:wrap;gap:.6rem;padding:1.2rem 0 2.5rem;border-top:1px solid color-mix(in srgb,currentColor 22%,transparent)}.stack span{font-size:.78rem;border:1px solid color-mix(in srgb,currentColor 24%,transparent);padding:.45rem .85rem;border-radius:2rem}.work-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1rem}.work-heading h2,.skills h2,.professional-footer h2{font-family:var(--font-serif);font-size:2rem;line-height:1.1}.work-heading>span{font-size:.75rem;opacity:.65}.work-grid{display:grid;grid-template-columns:1.8fr 1fr;gap:1.25rem;align-items:start}.tap,.small-project{border:1px solid color-mix(in srgb,currentColor 22%,transparent);border-radius:12px;overflow:hidden;background:var(--bg-muted)}.tap-visual{min-height:280px;background:#172c25;color:#d7f3cf;position:relative;overflow:hidden;padding:1.4rem}.tap-top{display:flex;justify-content:space-between;font-size:.62rem;letter-spacing:.15em;gap:1rem}.tap-visual svg{position:absolute;inset:35px 0 0;width:100%;height:calc(100% - 35px);opacity:.48}.tap-wordmark{position:relative;font-weight:800;font-size:clamp(3.5rem,8vw,6rem);line-height:.86;letter-spacing:-.09em;margin-top:3rem;text-shadow:0 3px 24px #172c25}.tap-wordmark span{display:block;font-size:.53em;letter-spacing:.16em;margin-top:.45rem}.tap-wordmark small{display:block;font-size:.72rem;font-weight:500;letter-spacing:.12em;margin-top:1.2rem}.tap-content{padding:clamp(1.2rem,3vw,2rem)}.tap-content h3,.small-project h3{font-family:var(--font-serif);font-size:2.1rem;line-height:1.1;margin:.55rem 0 .8rem}.tap-content>p:not(.eyebrow),.small-project>p:not(.eyebrow){font-size:.92rem;line-height:1.65;margin-bottom:.8rem}.services{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:1.4rem 0;padding:1.2rem 0;border-block:1px solid color-mix(in srgb,currentColor 20%,transparent)}.services span{font-size:.7rem;opacity:.6}.services h4{font-weight:650;font-size:.9rem;margin:.4rem 0}.services p,.tap-bottom p,.skills p:not(.eyebrow){font-size:.8rem;line-height:1.55;opacity:.85}.tap-bottom{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.tap-bottom strong{font-size:.8rem}.tap-bottom p{margin-top:.3rem}.side{display:grid;gap:1.25rem}.small-project{padding:1.4rem}.chatly-visual{background:#17171f;color:#f4f1e8;min-height:175px;padding:1rem;margin-top:1rem;border-radius:6px;display:flex;flex-direction:column;gap:.55rem}.chatly-visual>span{font-weight:800;font-size:1.7rem}.dot{color:#ffc900}.bubble{background:#262630;border:1px solid #f4f1e8;padding:.35rem .65rem;font-size:.75rem;align-self:flex-start}.bubble.reply{background:#ffc900;color:#17171f;align-self:flex-end}.chatly-visual small{font-size:.62rem;opacity:.65}.skills{display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr;gap:1.5rem;margin-top:3rem;padding:2rem 0;border-block:1px solid color-mix(in srgb,currentColor 22%,transparent)}.skills h2{margin-top:.45rem}.skills h3{font-weight:650;font-size:.9rem;margin-bottom:.5rem}.professional-footer{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-top:2rem}.professional-footer p{font-size:.9rem;margin-top:.5rem;opacity:.8}.professional-footer a{flex-shrink:0}@media(max-width:850px){.intro{grid-template-columns:1fr;gap:1.25rem}.work-grid{grid-template-columns:1fr}.side{grid-template-columns:1fr 1fr}.skills{grid-template-columns:1fr 1fr}}@media(max-width:520px){.side,.services,.tap-bottom,.skills{grid-template-columns:1fr}.work-heading,.professional-footer{align-items:flex-start;flex-direction:column}.tap-visual{min-height:230px}.intro h1{font-size:3rem}}
.contact-section{grid-template-columns:1.1fr 1fr 1fr;align-items:start}.contact-option{padding:1rem;border:1px solid color-mix(in srgb,currentColor 22%,transparent);border-radius:8px;min-width:0}.contact-option a{margin-top:.35rem;overflow-wrap:anywhere}.contact-option p{margin-top:.35rem}@media(max-width:850px){.contact-section{grid-template-columns:1fr 1fr}.contact-section>div:first-child{grid-column:1/-1}}@media(max-width:520px){.contact-section{grid-template-columns:1fr}}
</style>